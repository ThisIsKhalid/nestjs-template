model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String?
  displayName  String?
  platformRole PlatformRole?
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]

  @@index([status])
}
