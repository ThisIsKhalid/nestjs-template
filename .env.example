# App Environment & Server
NODE_ENV=development
PORT=8000
LOG_VERBOSE=false

# Database (PostgreSQL via Neon / Local / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?sslmode=prefer"

# Redis (Caching, Session, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication Secrets (minimum 32 characters)
JWT_ACCESS_SECRET=your_minimum_32_characters_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_minimum_32_characters_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

# S3 / Cloudflare R2 / MinIO Object Storage (Optional for local file uploads)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Frontend & Application URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=https://admin.joytechbd.com
BACKEND_URL=https://api.joytechbd.com
UPLOADS_URL=https://api.joytechbd.com/uploads
REVALIDATE_SECRET=your_nextjs_revalidation_secret_key_here

# BullMQ Queue Dashboard
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=your_bull_board_password_here

# Initial Superadmin Account (used by prisma/seed.ts)
SUPERADMIN_EMAIL=superadmin@ecommerce.local
SUPERADMIN_PASSWORD=superadmin_strong_password_1234

# Mail / SMTP Configuration
COMPANY_NAME="E-Commerce Store"
SMTP_SERVICE=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_SENDER=noreply@ecommerce.local

# Steadfast Courier BD Configuration
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=mock_api_key
STEADFAST_SECRET_KEY=mock_secret_key
STEADFAST_MOCK=true
